# Copie para .env.local (nunca commitado — ver .gitignore) e preencha com os valores reais
# do seu projeto Supabase (Project Settings > API).

# URL do projeto Supabase (ex.: https://xxxxxxxxxxxx.supabase.co). Pública (prefixo
# NEXT_PUBLIC_) — necessária tanto no servidor quanto no navegador para o fluxo de auth.
NEXT_PUBLIC_SUPABASE_URL=

# anon/publishable key — pública por natureza (é a mesma usada no SDK de navegador), mas
# só é segura de expor porque toda tabela tem RLS. Usada pelos clients de sessão
# (lib/supabase/server.ts, middleware.ts).
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# service_role key — NUNCA prefixar com NEXT_PUBLIC_, NUNCA expor ao navegador. Ignora RLS.
# Usada só em app/api/sync/route.ts e no bootstrap de cadastro (lib/supabase/admin.ts).
SUPABASE_SERVICE_ROLE_KEY=
